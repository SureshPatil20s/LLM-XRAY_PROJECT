# Firebase Web Configuration (from Firebase Console -> Project Settings -> General -> Your apps -> Web app)
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=localgpt-pro.firebaseapp.com
FIREBASE_PROJECT_ID=localgpt-pro
FIREBASE_APP_ID=1:1234567890:web:abcdef123456
GOOGLE_APPLICATION_CREDENTIALS=serviceAccountKey.json

# App configuration
DEFAULT_MODEL=Qwen/Qwen2.5-0.5B-Instruct
APP_NAME=SURESH.GPT LocalGPT Pro

